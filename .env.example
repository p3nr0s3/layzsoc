# LazySOC Environment Configuration
# Multiple keys can be comma-separated for rotation pools

# VirusTotal API Keys (comma-separated for key rotation)
VIRUSTOTAL_API_KEYS=

# AbuseIPDB API Keys (comma-separated for key rotation)
ABUSEIPDB_API_KEYS=

# NIST NVD 2.0 API Key (Optional: boosts rate limit from 5 to 50 req / 30s)
NVD_API_KEY=

# Cache Time-To-Live in hours (default: 24)
CACHE_TTL_HOURS=24

# Auto-throttle wait timeout in seconds when all keys are rate-limited (default: 65)
RATE_LIMIT_COOLDOWN_SECONDS=65

# Security lock: set to false in production to prevent web UI modification of API keys
ALLOW_KEY_MANAGEMENT=false
